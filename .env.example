# Copy to .env and fill in. These feed subscriber provisioning and the RAN config.
# Values below are lab defaults — change keys before any non-throwaway use.

# --- PLMN / network identity ---
MCC=999
MNC=70
TAC=1
SST=1
SD=0xffffff

# --- Test subscriber ---
IMSI=999700000000001
KI=465B5CE8B199B49FAA5F0A2EE238A6BC          # TODO: rotate
OPC=E8ED289DEBA952E4283B54E88E6183CA         # TODO: rotate
APN=internet

# --- Addressing (must match docker-compose networks) ---
UE_SUBNET=10.45.0.0/16
N6_IFACE=ogstun

# --- WebUI ---
WEBUI_PORT=9999
