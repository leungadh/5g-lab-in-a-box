__pycache__/
*.pyc
.venv/
venv/

# terraform
infra/terraform/.terraform/
*.tfstate
*.tfstate.*

# macOS
.DS_Store

# cSRX image archive (large, licensed — do NOT commit)
firewall/images/
*csrx*.tgz
*csrx*.tar

# private / not for the public repo
/private/
