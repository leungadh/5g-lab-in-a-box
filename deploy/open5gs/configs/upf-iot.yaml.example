# Second UPF — IoT slice (DNN 'iot', 10.46.0.0/16). Mounted at the default upf.yaml
# path in the upf-iot container; ogstun 10.46.0.1 + NAT are set by the image entrypoint
# (OGSTUN_ADDR / UE_SUBNET in docker-compose.yml).
logger:
  file:
    path: /opt/open5gs/var/log/open5gs/upf.log
global:
  max:
    ue: 1024
upf:
  pfcp:
    server:
    - address: upf-iot
    client: null
  gtpu:
    server:
    - address: upf-iot
  session:
  - subnet: 10.46.0.0/16
    gateway: 10.46.0.1
    dnn: iot
  metrics:
    server:
    - address: 0.0.0.0
      port: 9090
